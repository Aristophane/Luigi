[Unit]
Description=Luigi runtime signals (OOM kills and restarts)
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=luigi-agent
EnvironmentFile=/etc/luigi-agent.env
ExecStart=/usr/bin/python3 /opt/luigi-agent/luigi_runtime_collector.py
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
PrivateNetwork=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/luigi-agent
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
Nice=10
TimeoutStartSec=60s
UMask=0027
