FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY scripts ./scripts
COPY src ./src
COPY drizzle ./drizzle
COPY tsconfig.json ./
RUN npm run build:worker

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/build/worker ./build/worker
COPY scripts/migrate.mjs ./scripts/migrate.mjs
COPY drizzle ./drizzle

ENV NODE_ENV=production
USER node

# One worker resource owns migrations. Stop old web/worker processes before
# deploying a schema change; see docs/deployment-coolify.md.
CMD ["sh", "-c", "node scripts/migrate.mjs && exec node build/worker/worker.mjs"]
