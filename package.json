{
  "name": "luigi-monitoring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3011",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start --port 3011",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "worker": "node --env-file-if-exists=.env.local build/worker/worker.mjs",
    "worker:dev": "node --env-file-if-exists=.env.local --import ./scripts/register.mjs src/worker.ts",
    "test": "npm run build:worker && node --import ./scripts/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "server-only": "0.0.1",
    "web-push": "^3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3"
  }
}
